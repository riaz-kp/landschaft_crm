# Copy to .env.local for local development, and set the same two variables in
# the hosting provider (Vercel → Project → Settings → Environment Variables).
#
# Both come from Supabase → Project Settings → API. The publishable (anon) key
# is meant for the browser: row-level security decides what it can reach.
# Never put the service-role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
