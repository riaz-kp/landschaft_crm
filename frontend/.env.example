# Copy to .env.local for local development. Production builds (Vercel) read
# .env.production, which already holds the live project's values.
#
# Both come from Supabase → Project Settings → API. The publishable (anon) key
# is meant for the browser: row-level security decides what it can reach.
# Never put the service-role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
