# Read by every production build (`vite build`), including Vercel's, so the
# hosted app reaches the database with no dashboard setup.
#
# Both values are public by design: they ship inside the app every browser
# downloads, and row-level security in the database decides what they can
# reach. Never put the service-role / secret key in any .env file here.
# Environment variables set in Vercel take precedence over this file.
VITE_SUPABASE_URL=https://crcnhsvloczzaqjjouky.supabase.co
